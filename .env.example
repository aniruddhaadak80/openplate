# OpenPlate environment variables.
#
# Local development needs NONE of these. When DATABASE_URL is unset outside
# production the app runs on an embedded PGlite database in ./.pglite, so
# `git clone && npm install && npm run dev` works with an empty environment.
#
# Production (Vercel) REQUIRES DATABASE_URL. Without it the production build
# refuses to open the repository rather than silently falling back to a
# non-durable store, and /api/health reports ok:false with durable:false.
#
# OpenPlate has no third-party API keys on purpose. The Metropolitan Museum of
# Art Collection API, The Cleveland Museum of Art Open Access API and Wikidata
# are all public, keyless endpoints.

# Hosted Postgres connection string. Neon through the Vercel Marketplace
# integration supplies this automatically.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: schema namespace, so several projects can share one database.
# Defaults to the public schema.
# DATABASE_SCHEMA=openplate

# Optional: the absolute canonical origin, used for metadata, the sitemap, the
# share route and the MCP manifest. Defaults to the production alias Vercel
# injects (VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL), then to
# http://localhost:3000. Prefer letting Vercel inject it.
# NEXT_PUBLIC_SITE_URL=https://openplate.vercel.app

# Optional: force the sealed offline sample instead of contacting the
# institutions. Used by deterministic tests and by offline local runs.
# OPENPLATE_OFFLINE=1

# Optional, LOCAL REHEARSALS ONLY. Lets a production build boot against the
# embedded PGlite store so npm run verify:local and npm run smoke can exercise
# the real production bundle without a database. Data is NOT durable. Never set
# this in a real deployment: a production instance without DATABASE_URL must fail
# to boot rather than accept writes into volatile storage.
# OPENPLATE_ALLOW_EMBEDDED=1

# Optional: where the embedded database keeps its files. Defaults to ./.pglite.
# PGLITE_DIR=.pglite

# Optional: the anonymous session cookie name. Defaults to op_scope; change it
# only if two OpenPlate instances share a host.
# SESSION_COOKIE_NAME=op_scope